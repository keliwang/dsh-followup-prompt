{
  "name": "dsh-followup-prompt",
  "version": "0.1.0",
  "description": "Followup Prompt for DeepSeek Harness: predicts your next message after each completed turn and offers it as an editable draft (Tab to accept, never auto-send).",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "deepseek",
    "composer",
    "prediction",
    "followup-prompt"
  ],
  "license": "MIT",
  "author": "Keli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keliwang/dsh-followup-prompt.git"
  },
  "homepage": "https://github.com/keliwang/dsh-followup-prompt#readme",
  "bugs": {
    "url": "https://github.com/keliwang/dsh-followup-prompt/issues"
  },
  "type": "module",
  "exports": {
    ".": "./host/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "host/",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs/protocol.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test \"verify/*.test.mjs\"",
    "pack:dry": "pnpm pack --dry-run",
    "links": "node scripts/link-dev-deps.mjs",
    "deps:ci": "npm install --no-save --no-audit --no-fund @deepseek-ai/schemastery@3 @deepseek-ai/dsh-llm@0.2.1-rc.2",
    "prepublishOnly": "npm test"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "engines": {
    "dsh": ">=0.2.0 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
